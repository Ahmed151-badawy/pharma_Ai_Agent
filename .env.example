# Copy to .env and fill in. NO spaces around "=" (Docker --env-file keeps them as part of the value).

# --- LLM ---
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# Other verified active models on Groq: openai/gpt-oss-20b, qwen/qwen3.8-27b

# --- Auth (required) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# The first admin is created on startup if the users table is empty. Change the password after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# --- PostgreSQL ---
# Docker Desktop with Postgres on your PC: host.docker.internal | docker compose: db (set automatically)
# Running python directly on your PC: localhost
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=pharma_inventory
DB_USER=postgres
DB_PASSWORD=postgres
# Or one URL instead of the DB_* values (Render/Heroku style is accepted):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional but recommended: the agent's SQL tool then uses a role that can ONLY read the 3 inventory tables.
# 8-128 chars from: A-Z a-z 0-9 _ . @ # ^ ~ + = ! -
# READONLY_DB_PASSWORD=

# --- Demo ---
# Insert 3 medicines / 4 batches on startup (safe to leave on: it never overwrites existing stock)
SEED_DEMO_DATA=true

# --- Observability: LangSmith traces every agent step and tool call (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pharma-agent

# --- Misc ---
# LOG_LEVEL=INFO
# LOG_JSON=true            # false = human-readable logs for local development
# CORS_ORIGINS=            # comma-separated, only for a browser-based frontend
